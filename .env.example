# ──────────────────────────────────────────────────────────────────────────────
# resume-bot · Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram user ID (find it via @userinfobot or @getidsbot)
TELEGRAM_ALLOWED_USER_ID=123456789

# Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override. The default is gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Optional host user IDs used to run the container without root privileges.
# RESUME_BOT_UID=1000
# RESUME_BOT_GID=1000
